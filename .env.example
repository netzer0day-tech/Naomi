# ─── Naomi's Blog — Environment Variables ───────────────
# Copy this file to .env and fill in your values.
# Never commit your real .env to git!

# Flask secret key — change this to something long and random
SECRET_KEY=change-me-to-something-long-and-secret

# Admin panel password
ADMIN_PASSWORD=naomi2024♥

# Port (defaults to 5000)
PORT=5000

# Flask env: development | production
FLASK_ENV=production

# Optional: Anthropic API key for AI daily love messages
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Custom domain / base URL (for SEO meta tags)
BASE_URL=https://naomi.yourdomain.com
